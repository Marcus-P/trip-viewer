{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trip Viewer",
  "version": "../package.json",
  "identifier": "com.tripviewer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Trip Viewer",
        "width": 1280,
        "height": 760,
        "minWidth": 720,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**/*"
          ]
        }
      }
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "dmg",
      "app",
      "deb"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "section": "video",
        "depends": [
          "gstreamer1.0-libav",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-plugins-ugly"
        ],
        "files": {
          "/usr/share/doc/trip-viewer/LICENSE": "../release-assets/LICENSE",
          "/usr/share/doc/trip-viewer/THIRD_PARTY_NOTICES.md": "../release-assets/THIRD_PARTY_NOTICES.md",
          "/usr/share/doc/trip-viewer/NODE_RUNTIME_LICENSES.txt": "../release-assets/NODE_RUNTIME_LICENSES.txt",
          "/usr/share/doc/trip-viewer/RUST_DEPENDENCY_LICENSES.txt": "../release-assets/RUST_DEPENDENCY_LICENSES.txt",
          "/usr/share/doc/trip-viewer/NODE_RUNTIME_LICENSE_TEXTS.tar.gz": "../release-assets/NODE_RUNTIME_LICENSE_TEXTS.tar.gz",
          "/usr/share/doc/trip-viewer/RUST_DEPENDENCY_LICENSE_TEXTS.tar.gz": "../release-assets/RUST_DEPENDENCY_LICENSE_TEXTS.tar.gz"
        }
      }
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.comodoca.com"
    }
  }
}
